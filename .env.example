DISCORD_TOKEN=
# Notion 보고서 링크와 수집 실패 알림을 보낼 Discord 채널
REPORT_CHANNEL_ID=
# 선택: 비워 두면 REPORT_CHANNEL_ID의 서버를 사용
DISCORD_GUILD_ID=

OPENAI_API_KEY=
# 계정에서 사용 가능한 Responses API 텍스트 모델 ID를 입력
OPENAI_MODEL=

NOTION_TOKEN=
# 일반 페이지 아래에 저장하려면 부모 페이지 ID를 입력
NOTION_PARENT_PAGE_ID=
# 데이터베이스에 저장할 경우 위 값을 비우고 데이터 소스 ID를 입력
NOTION_DATA_SOURCE_ID=
# 데이터 소스 사용 시 실제 제목 속성 이름 (예: 이름, Name)
NOTION_TITLE_PROPERTY=Name

# 일정, 수집 대상, 제출 원문, 보고서 기록. 배포 시 영구 디스크 경로로 설정
DATA_DIR=./data
PORT=3000
